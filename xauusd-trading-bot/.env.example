# Copy to .env and fill in. Never commit the real file.
WEBHOOK_SECRET=change-me-to-a-long-random-string
BRIDGE_PORT=8080
BROKER=paper                 # paper | oanda
ALLOWED_SYMBOLS=XAUUSD

# Bridge-side risk limits (apply even if the Pine inputs are wrong)
MAX_UNITS=100                # ounces
MAX_RISK_PCT=2.5             # % of balance at risk per trade (Pine default is 2%; small headroom for rounding)
MAX_LEVERAGE=1.0             # max notional as a multiple of balance (1 = no leverage)
MAX_DAILY_LOSS_PCT=5.0
MAX_TRADES_PER_DAY=4
MAX_SIGNAL_DELAY_S=120
KILL_SWITCH_FILE=KILL_SWITCH # create this file to block all new entries

# Optional extra protection (the secret is the main guard): only accept webhooks from these IPs / CIDR ranges.
# TradingView's webhook IPs: 52.89.214.238, 34.212.75.30, 54.218.53.128, 52.32.178.7 - verify on TradingView's
# help page ("How to configure webhook alerts"); the list can change.
# IP_ALLOWLIST=52.89.214.238,34.212.75.30,54.218.53.128,52.32.178.7
# Behind a local proxy/tunnel every request comes from 127.0.0.1, so name the header that carries the real
# client IP. It is trusted only on requests from a loopback peer; X-Forwarded-For is never used (spoofable).
# For cloudflared: CF-Connecting-IP (set by Cloudflare's edge, which overwrites any client-supplied value).
# TRUSTED_IP_HEADER=CF-Connecting-IP

PAPER_START_BALANCE=10000
PAPER_SPREAD=0.30

# OANDA (only if BROKER=oanda). Start with a practice account.
OANDA_ENV=practice
OANDA_ACCOUNT_ID=
OANDA_TOKEN=
# ALLOW_LIVE_TRADING=yes-i-understand-the-risk   # required for OANDA_ENV=live
OANDA_TIMEOUT_S=10           # per HTTP request to OANDA

# auto (default) = async for OANDA, sync for paper. async answers TradingView 202 at once (it gives up after ~3 s)
# and places orders in a background worker, one at a time, in arrival order. sync places the order first.
EXECUTION_MODE=auto          # auto | sync | async

# High-impact news guard (FOMC, NFP, CPI). Rejects new entries in the window before/after a release.
NEWS_BLOCK_HOURS=24          # 0 disables
NEWS_BLOCK_AFTER_MIN=30
NEWS_EVENTS=FOMC,NFP,CPI
# NEWS_CALENDAR=data/high_impact_usd.csv
